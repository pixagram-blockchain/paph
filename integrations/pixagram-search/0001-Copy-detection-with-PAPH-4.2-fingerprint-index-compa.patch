index 0000000..f39a567
--- /dev/null
+++ b/migrations/0002_paph.sql
@@ -0,0 +1,30 @@
+-- PAPH copy detection: the comparator's verdicts.
+--
+-- The fingerprints (Tier 1 + Tier 2 wires, ~4–24 KB per artwork) and the inverted index over
+-- their keys live in the PaphIndex Durable Object (src/paph/store.ts), where the comparator
+-- runs next to them. D1 keeps only what the comparator concluded, so the API can list and
+-- filter verdicts next to posts. Written by the "paph" enrichment stage (jobs.stage = 'paph').
+
+-- content_hash the paph stage last completed for (fingerprint indexed AND verdicts written),
+-- like stats_hash / embed_hash / describe_hash
+ALTER TABLE artworks ADD COLUMN paph_hash TEXT;
+
+CREATE TABLE IF NOT EXISTS paph_matches (
+  a           INTEGER NOT NULL,                 -- the earlier post (chain time, then id)
+  b           INTEGER NOT NULL,                 -- the later post
+  verdict     TEXT    NOT NULL,                 -- Suspected | Copy | Identical
+  state       INTEGER NOT NULL,                 -- 2 | 3 | 4, for ordering and thresholds
+  certifiable INTEGER NOT NULL,                 -- the comparator stands behind the verdict
+  structural  INTEGER NOT NULL,                 -- structural agreement, 0..10000
+  geometry    INTEGER NOT NULL,                 -- geometric evidence, 0..10000
+  inliers     INTEGER NOT NULL,                 -- keypoint correspondences in the agreeing models
+  mirrored    INTEGER NOT NULL,                 -- the geometry is a reflection
+  same_author INTEGER NOT NULL,
+  via         TEXT    NOT NULL,                 -- channels that nominated the pair: codes,bands,phash,vector,previous
+  comparator  INTEGER NOT NULL,                 -- 42
+  calibration TEXT    NOT NULL,                 -- the calibration identity the report cites (calibrationId)
+  computed    INTEGER NOT NULL,                 -- unix seconds
+  PRIMARY KEY (a, b)
+);
+CREATE INDEX IF NOT EXISTS paph_matches_b    ON paph_matches (b);
+CREATE INDEX IF NOT EXISTS paph_matches_feed ON paph_matches (computed DESC);
