index 0000000..f932be0
--- /dev/null
+++ b/src/paph/index-do.ts
@@ -0,0 +1,73 @@
+// PaphIndex: the copy-detection index as a single SQLite-backed Durable Object.
+//
+// It holds every artwork's PAPH wires and the inverted index over them, and runs the
+// comparator next to that data, so a query ships one fingerprint in and a few verdicts out —
+// never the candidates' wires. Hashing (the CPU-heavy step that needs pixels) stays in the
+// queue consumer and the API Worker. One named instance ("main") serves the whole corpus; at
+// Pixagram's scale a query is a few milliseconds of SQLite and ~2–5 ms of comparator per
+// candidate that survives the screen.
+
+import { DurableObject } from "cloudflare:workers";
+import type { Env } from "../env";
+import { paphEngine } from "./engine";
+import { PaphStore, type FindOptions, type FindResult, type WireInput, type WorkInfo, type WorkInput } from "./store";
+
+export interface IndexResult extends FindResult {
+  keys: { codes: number; bands: number };
+  replaced: boolean;
+}
+
+export class PaphIndex extends DurableObject<Env> {
+  private store!: PaphStore;
+
+  constructor(ctx: DurableObjectState, env: Env) {
+    super(ctx, env);
+    ctx.blockConcurrencyWhile(async () => {
+      const engine = await paphEngine();
+      this.store = new PaphStore(ctx.storage.sql, (fn) => ctx.storage.transactionSync(fn), engine);
+      this.store.migrate();
+    });
+  }
+
+  /** Store a work's wires, index it, and check it against everything already indexed. */
+  async index(work: WorkInput, find: FindOptions = {}): Promise<IndexResult> {
+    const put = this.store.put(work);
+    const found = this.store.find(work.postId, find);
+    return { ...found, ...put };
+  }
+
+  async remove(postId: number): Promise<boolean> {
+    return this.store.remove(postId);
+  }
+
+  /** Copies of a stored work (by id) or of a fingerprint that is not stored (an upload). */
+  async find(query: WireInput | number, opts: FindOptions = {}): Promise<FindResult> {
+    return this.store.find(query, opts);
+  }
+
+  async info(postId: number): Promise<WorkInfo | null> {
+    return this.store.info(postId);
+  }
+
+  async wires(postId: number): Promise<(WireInput & { contentHash: string }) | null> {
+    return this.store.wires(postId);
+  }
+
+  /** The full comparator-42 report, as JSON text. */
+  async report(a: WireInput | number, b: WireInput | number, lean = false): Promise<string | null> {
+    return this.store.report(a, b, lean);
+  }
+
+  /** The report for two stored works, with the content hashes of the wires it used. */
+  async reportStored(a: number, b: number, lean = false): Promise<{ text: string; hashA: string; hashB: string } | null> {
+    return this.store.reportStored(a, b, lean);
+  }
+
+  async rekey(limit = 200): Promise<ReturnType<PaphStore["rekey"]>> {
+    return this.store.rekey(limit);
+  }
+
+  async stats(): Promise<ReturnType<PaphStore["stats"]> & { bytes: number }> {
+    return { ...this.store.stats(), bytes: this.ctx.storage.sql.databaseSize };
+  }
+}
diff --git a/src/paph/store.ts b/src/paph/store.ts
new file mode 100644
index 0000000..e603356
--- /dev/null
+++ b/src/paph/store.ts
@@ -0,0 +1,481 @@
+// PaphStore — PAPH fingerprints, an inverted index over them, and the comparator, on SQLite.
+//
+// It runs inside the PaphIndex Durable Object (ctx.storage.sql), so the comparator reads the
+// candidates' wires from local storage instead of shipping ~24 KB per candidate through a
+// network database, and in tests on node:sqlite. Nothing here touches the network.
+//
+//   paph_works  one row per artwork: Tier 1 + Tier 2 wires, the keys it is indexed under
+//   paph_keys   inverted index (kind, key) → post_id     kind 1: Tier-1 local code (53-bit)
+//                                                        kind 2: descriptor band (j·2^24 + v)
+//   paph_df     how many works hold each key — IDF weights, and a cap on useless keys
+//
+// A query scores every work sharing a key by Σ 1/df per family, keeps the top K of each,
+// adds candidates other channels nominated (pHash, embeddings), and runs comparator 42 on
+// the lot, screen-gated. Keys only nominate; the comparator decides.
+
+import { KEYS_VERSION, STATE, STATES, type Engine, type IndexKeys, type RankRecord, type Side, type Verdict } from "./engine";
+
+export interface SqlCursor {
+  toArray(): Record<string, unknown>[];
+}
+/** The subset of Durable Object SqlStorage the store uses (node:sqlite in tests). */
+export interface Sql {
+  exec(query: string, ...bindings: unknown[]): SqlCursor;
+}
+export type Transact = <T>(fn: () => T) => T;
+
+export const KIND_CODE = 1;
+export const KIND_BAND = 2;
+
+export interface WireInput {
+  t1: Uint8Array;
+  t2?: Uint8Array | null;
+}
+
+export interface WorkInput extends WireInput {
+  postId: number;
+  /** content hash of the image the wires were computed from (sha256 hex) */
+  contentHash: string;
+}
+
+export interface WorkInfo {
+  postId: number;
+  contentHash: string;
+  kp: number;
+  width: number;
+  height: number;
+  keysVersion: number;
+  updated: number;
+}
+
+export interface Nomination {
+  id: number;
+  /** channels that nominated it: codes, bands, and whatever the caller passed (phash, vector, …) */
+  via: string[];
+  /** Σ 1/df over the shared keys of each family */
+  codes: number;
+  bands: number;
+}
+
+export interface Match {
+  id: number;
+  verdict: Verdict;
+  state: number;
+  certifiable: boolean;
+  structural: number;
+  geometryEvidence: number;
+  totalInliers: number;
+  localEvidence: number;
+  mirrored: boolean;
+  swapped: boolean;
+  via: string[];
+  score: { codes: number; bands: number };
+  /** content hash of the stored wires this verdict was reached against */
+  contentHash: string;
+}
+
+/** Comparisons per batch: wires loaded and sides prepared a batch at a time keep memory flat. */
+const RANK_BATCH = 64;
+
+export interface FindOptions {
+  /** top K per key family (default 32) */
+  perFamily?: number;
+  /** keys held by more works than this are skipped (default 256) */
+  dfCap?: number;
+  /**
+   * Candidates nominated by other channels. Not cut by the key budget: their producers bound
+   * them (pHash and embedding neighbours take a top k, previous partners a few hundred).
+   */
+  extra?: Array<{ id: number; via: string }>;
+  /** nominate by index keys too (default true); false checks only `extra` */
+  keys?: boolean;
+  exclude?: number[];
+  /** keep verdicts at or above this state (default Suspected); Indeterminate is never kept */
+  minState?: number;
+  /** skip the comparison for pairs the stage-1 screen rejects (default true) */
+  gate?: boolean;
+}
+
+/** Which comparator and calibration produced a set of verdicts — stored beside them. */
+export interface Identity {
+  comparator: number;
+  calibration: string;
+  calibrationId: string;
+}
+
+export interface FindResult {
+  matches: Match[];
+  /**
+   * Every work this query was actually checked against (screened, and compared if it passed),
+   * whatever the verdict: the pairs whose stored verdicts this result replaces. Nominated works
+   * without stored wires are not in it.
+   */
+  checked: number[];
+  /** works nominated (after exclusions) */
+  nominated: number;
+  /** of the checked, rejected by the screen */
+  unscreened: number;
+  identity: Identity;
+}
+
+const now = (): number => Math.floor(Date.now() / 1000);
+
+/** BLOBs come back as ArrayBuffer (Durable Objects), Uint8Array (node:sqlite) or number[] (D1). */
+export function asBytes(v: unknown): Uint8Array | null {
+  if (v === null || v === undefined) return null;
+  if (v instanceof Uint8Array) return v;
+  if (v instanceof ArrayBuffer) return new Uint8Array(v);
+  if (ArrayBuffer.isView(v)) return new Uint8Array(v.buffer, v.byteOffset, v.byteLength);
+  if (Array.isArray(v)) return Uint8Array.from(v as number[]);
+  return null;
+}
+
+/** An exact ArrayBuffer for a BLOB binding. */
+function blob(u: Uint8Array | null | undefined): ArrayBuffer | null {
+  if (!u) return null;
+  return (u.byteOffset === 0 && u.byteLength === u.buffer.byteLength ? u.buffer : u.slice().buffer) as ArrayBuffer;
+}
+
+/** The (kind, key) pairs of a key set as one JSON text for json_each. */
+const keysJson = (k: { codes: number[]; bands: number[] }): string => JSON.stringify({ codes: k.codes, bands: k.bands });
+
+/** SELECT kind, key FROM the JSON key set bound as ?1 */
+const KEYSET = `SELECT ${KIND_CODE} AS kind, value AS key FROM json_each(?1, '$.codes')
+                UNION ALL SELECT ${KIND_BAND}, value FROM json_each(?1, '$.bands')`;
+
+/** Every statement the index runs, so tests can hold their query plans to the primary keys. */
+export const SQL = {
+  /** ?1 key set, ?2 post id */
+  insertKeys: `INSERT OR IGNORE INTO paph_keys (kind, key, post_id) SELECT kind, key, ?2 FROM (${KEYSET})`,
+  /** ?1 key set */
+  incDf: `INSERT INTO paph_df (kind, key, n) SELECT kind, key, 1 FROM (${KEYSET}) WHERE true
+          ON CONFLICT(kind, key) DO UPDATE SET n = n + 1`,
+  /** ?1 key set, ?2 post id — the whole primary key in the IN, or SQLite scans the table */
+  deleteKeys: `DELETE FROM paph_keys WHERE (kind, key, post_id) IN (SELECT kind, key, ?2 FROM (${KEYSET}))`,
+  /** ?1 key set (the compound key set goes through a FROM subquery: written bare, SQLite scans) */
+  decDf: `UPDATE paph_df SET n = n - 1 WHERE (kind, key) IN (SELECT kind, key FROM (${KEYSET}))`,
+  /** ?1 key set */
+  dropDf: `DELETE FROM paph_df WHERE n <= 0 AND (kind, key) IN (SELECT kind, key FROM (${KEYSET}))`,
+  /** ?1 query key set, ?2 df cap, ?3 top K per family, ?4 JSON array of excluded post ids */
+  nominate: `WITH q AS (${KEYSET}),
+     live AS (SELECT q.kind AS kind, q.key AS key, d.n AS n FROM q CROSS JOIN paph_df d ON d.kind = q.kind AND d.key = q.key WHERE d.n <= ?2),
+     hits AS (
+       SELECT k.post_id AS id,
+              SUM(CASE WHEN live.kind = ${KIND_CODE} THEN 1.0 / live.n ELSE 0 END) AS codes,
+              SUM(CASE WHEN live.kind = ${KIND_BAND} THEN 1.0 / live.n ELSE 0 END) AS bands
+       FROM live CROSS JOIN paph_keys k ON k.kind = live.kind AND k.key = live.key
+       WHERE k.post_id NOT IN (SELECT value FROM json_each(?4))
+       GROUP BY k.post_id
+     ),
+     ranked AS (
+       SELECT id, codes, bands,
+              ROW_NUMBER() OVER (ORDER BY codes DESC, id) AS rc,
+              ROW_NUMBER() OVER (ORDER BY bands DESC, id) AS rb
+       FROM hits
+     )
+     SELECT id, codes, bands, rc, rb FROM ranked
+     WHERE (codes > 0 AND rc <= ?3) OR (bands > 0 AND rb <= ?3)
+     ORDER BY MIN(CASE WHEN codes > 0 THEN rc ELSE 1e9 END, CASE WHEN bands > 0 THEN rb ELSE 1e9 END), id`,
+  /** ?1 JSON array of post ids */
+  loadWires: "SELECT post_id, content_hash, t1, t2 FROM paph_works WHERE post_id IN (SELECT value FROM json_each(?1))",
+};
+
+export const SCHEMA = [
+  `CREATE TABLE IF NOT EXISTS paph_works (
+     post_id      INTEGER PRIMARY KEY,
+     content_hash TEXT    NOT NULL,
+     t1           BLOB    NOT NULL,
+     t2           BLOB,
+     kp           INTEGER NOT NULL,
+     width        INTEGER NOT NULL,
+     height       INTEGER NOT NULL,
+     keys_version INTEGER NOT NULL,
+     keys         TEXT    NOT NULL,
+     updated      INTEGER NOT NULL
+   )`,
+  `CREATE TABLE IF NOT EXISTS paph_keys (
+     kind    INTEGER NOT NULL,
+     key     INTEGER NOT NULL,
+     post_id INTEGER NOT NULL,
+     PRIMARY KEY (kind, key, post_id)
+   ) WITHOUT ROWID`,
+  `CREATE TABLE IF NOT EXISTS paph_df (
+     kind INTEGER NOT NULL,
+     key  INTEGER NOT NULL,
+     n    INTEGER NOT NULL,
+     PRIMARY KEY (kind, key)
+   ) WITHOUT ROWID`,
+];
+
+export class PaphStore {
+  constructor(
+    private readonly sql: Sql,
+    private readonly transact: Transact,
+    private readonly engine: Engine,
+  ) {}
+
+  migrate(): void {
+    for (const s of SCHEMA) this.sql.exec(s).toArray();
+  }
+
+  // ---- writes ------------------------------------------------------------------------
+
+  /**
+   * Store (or replace) a work's wires and index it. Keys are derived here, from the wires,
+   * so the index always matches the engine that will compare. Throws when Tier 1 is refused.
+   */
+  put(w: WorkInput): { keys: { codes: number; bands: number }; replaced: boolean } {
+    const side = this.engine.prepare(w.t1, w.t2 ?? null, { strict: true });
+    try {
+      const k = this.engine.indexKeys(side);
+      const json = keysJson(k);
+      let replaced = false;
+      this.transact(() => {
+        const old = this.sql.exec("SELECT keys FROM paph_works WHERE post_id = ?", w.postId).toArray()[0];
+        if (old) {
+          this.unindex(w.postId, String(old.keys));
+          replaced = true;
+        }
+        this.sql
+          .exec(
+            `INSERT INTO paph_works (post_id, content_hash, t1, t2, kp, width, height, keys_version, keys, updated)
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+             ON CONFLICT(post_id) DO UPDATE SET content_hash = excluded.content_hash, t1 = excluded.t1, t2 = excluded.t2,
+               kp = excluded.kp, width = excluded.width, height = excluded.height, keys_version = excluded.keys_version,
+               keys = excluded.keys, updated = excluded.updated`,
+            w.postId, w.contentHash, blob(w.t1), blob(w.t2 ?? null),
+            side.kp, side.width, side.height, KEYS_VERSION, json, now(),
+          )
+          .toArray();
+        this.index(w.postId, json);
+      });
+      return { keys: { codes: k.codes.length, bands: k.bands.length }, replaced };
+    } finally {
+      side.free();
+    }
+  }
+
+  /** Drop a work and its keys. */
+  remove(postId: number): boolean {
+    let found = false;
+    this.transact(() => {
+      const old = this.sql.exec("SELECT keys FROM paph_works WHERE post_id = ?", postId).toArray()[0];
+      if (!old) return;
+      this.unindex(postId, String(old.keys));
+      this.sql.exec("DELETE FROM paph_works WHERE post_id = ?", postId).toArray();
+      found = true;
+    });
+    return found;
+  }
+
+  /**
+   * Re-derive the keys of works indexed under an older KEYS_VERSION, from their stored wires —
+   * no re-hashing, no image fetch. A work whose stored Tier 1 this engine refuses (a corrupt
+   * row, or wires from another wire version) is marked keys_version −1 — "re-hash me": the
+   * enrichment stage then redoes it — instead of failing every call at the same row.
+   */
+  rekey(limit = 200): { rekeyed: number; unreadable: number; remaining: number } {
+    const rows = this.sql
+      .exec("SELECT post_id, content_hash, t1, t2 FROM paph_works WHERE keys_version <> ? AND keys_version >= 0 LIMIT ?", KEYS_VERSION, limit)
+      .toArray();
+    let rekeyed = 0, unreadable = 0;
+    for (const r of rows) {
+      try {
+        this.put({ postId: Number(r.post_id), contentHash: String(r.content_hash), t1: asBytes(r.t1)!, t2: asBytes(r.t2) });
+        rekeyed++;
+      } catch {
+        this.sql.exec("UPDATE paph_works SET keys_version = -1 WHERE post_id = ?", Number(r.post_id)).toArray();
+        unreadable++;
+      }
+    }
+    const left = this.sql.exec("SELECT COUNT(*) AS n FROM paph_works WHERE keys_version <> ? AND keys_version >= 0", KEYS_VERSION).toArray()[0];
+    return { rekeyed, unreadable, remaining: Number(left?.n ?? 0) };
+  }
+
+  private index(postId: number, json: string): void {
+    this.sql.exec(SQL.insertKeys, json, postId).toArray();
+    this.sql.exec(SQL.incDf, json).toArray();
+  }
+
+  private unindex(postId: number, json: string): void {
+    this.sql.exec(SQL.deleteKeys, json, postId).toArray();
+    this.sql.exec(SQL.decDf, json).toArray();
+    this.sql.exec(SQL.dropDf, json).toArray();
+  }
+
+  // ---- reads -------------------------------------------------------------------------
+
+  info(postId: number): WorkInfo | null {
+    const r = this.sql
+      .exec("SELECT post_id, content_hash, kp, width, height, keys_version, updated FROM paph_works WHERE post_id = ?", postId)
+      .toArray()[0];
+    if (!r) return null;
+    return {
+      postId: Number(r.post_id),
+      contentHash: String(r.content_hash),
+      kp: Number(r.kp),
+      width: Number(r.width),
+      height: Number(r.height),
+      keysVersion: Number(r.keys_version),
+      updated: Number(r.updated),
+    };
+  }
+
+  wires(postId: number): (WireInput & { contentHash: string }) | null {
+    const r = this.sql.exec("SELECT content_hash, t1, t2 FROM paph_works WHERE post_id = ?", postId).toArray()[0];
+    if (!r) return null;
+    return { contentHash: String(r.content_hash), t1: asBytes(r.t1)!, t2: asBytes(r.t2) };
+  }
+
+  /**
+   * Works sharing keys with a query, top `perFamily` of each family by Σ 1/df. Keys held by
+   * more than `dfCap` works are skipped outright: they cost a long posting list and carry
+   * almost no weight.
+   */
+  nominate(q: IndexKeys, perFamily = 32, dfCap = 256, exclude: number[] = []): Nomination[] {
+    const rows = this.sql.exec(SQL.nominate, keysJson(q), dfCap, perFamily, JSON.stringify(exclude)).toArray();
+    return rows.map((r) => {
+      const codes = Number(r.codes), bands = Number(r.bands);
+      const via: string[] = [];
+      if (codes > 0 && Number(r.rc) <= perFamily) via.push("codes");
+      if (bands > 0 && Number(r.rb) <= perFamily) via.push("bands");
+      return { id: Number(r.id), via, codes: round(codes), bands: round(bands) };
+    });
+  }
+
+  /**
+   * Find the works a query (wires, or a stored post id) copies or is copied by. The query is
+   * hashed already; nothing here decodes images. Order of comparison: the other channels'
+   * candidates first (previous partners above all), then the key nominations.
+   */
+  find(query: WireInput | number, o: FindOptions = {}): FindResult {
+    const perFamily = o.perFamily ?? 32;
+    const minState = o.minState ?? STATE.Suspected;
+    const exclude = new Set(o.exclude ?? []);
+    const empty = (): FindResult => ({ matches: [], checked: [], nominated: 0, unscreened: 0, identity: this.identity() });
+    let wires: WireInput | null;
+    if (typeof query === "number") {
+      exclude.add(query);
+      wires = this.wires(query);
+      if (!wires) return empty();
+    } else wires = query;
+
+    const qs = this.engine.prepare(wires.t1, wires.t2 ?? null, { strict: true });
+    const sides: Side[] = [];
+    try {
+      const noms = new Map<number, Nomination>();
+      const extra = [...(o.extra ?? [])].sort((a, b) => Number(b.via === "previous") - Number(a.via === "previous"));
+      for (const e of extra) {
+        if (exclude.has(e.id) || !Number.isSafeInteger(e.id)) continue;
+        const n = noms.get(e.id);
+        if (n) {
+          if (!n.via.includes(e.via)) n.via.push(e.via);
+        } else noms.set(e.id, { id: e.id, via: [e.via], codes: 0, bands: 0 });
+      }
+      if (o.keys !== false) {
+        for (const k of this.nominate(this.engine.indexKeys(qs, { query: true }), perFamily, o.dfCap ?? 256, [...exclude])) {
+          const n = noms.get(k.id);
+          if (n) {
+            n.via.unshift(...k.via);
+            n.codes = k.codes;
+            n.bands = k.bands;
+          } else noms.set(k.id, k);
+        }
+      }
+      const list = [...noms.values()];
+      if (!list.length) return empty();
+
+      const matches: Match[] = [];
+      const checked: number[] = [];
+      let unscreened = 0;
+      for (let at = 0; at < list.length; at += RANK_BATCH) {
+        const batch = list.slice(at, at + RANK_BATCH);
+        const byId = new Map(batch.map((n) => [n.id, n]));
+        const order: Array<{ n: Nomination; hash: string }> = [];
+        for (const r of this.sql.exec(SQL.loadWires, JSON.stringify(batch.map((n) => n.id))).toArray()) {
+          // stored wires came from this engine's hasher; a work whose Tier 1 no longer parses is skipped, not fatal
+          try {
+            sides.push(this.engine.prepare(asBytes(r.t1)!, asBytes(r.t2)));
+            order.push({ n: byId.get(Number(r.post_id))!, hash: String(r.content_hash) });
+          } catch {
+            /* unreadable stored wire */
+          }
+        }
+        const recs: RankRecord[] = sides.length ? this.engine.rank(qs, sides, { gate: o.gate ?? true }) : [];
+        for (const s of sides.splice(0)) s.free();
+        recs.forEach((r, i) => {
+          const { n, hash } = order[i];
+          checked.push(n.id);
+          if (r.state < 0) {
+            unscreened++;
+            return;
+          }
+          if (r.state < minState || r.state > STATE.Identical) return;
+          matches.push({
+            id: n.id,
+            verdict: STATES[r.state] as Verdict,
+            state: r.state,
+            certifiable: r.certifiable,
+            structural: r.structural,
+            geometryEvidence: r.geometryEvidence,
+            totalInliers: r.totalInliers,
+            localEvidence: r.localEvidence,
+            mirrored: r.mirrored,
+            swapped: r.swapped,
+            via: n.via,
+            score: { codes: n.codes, bands: n.bands },
+            contentHash: hash,
+          });
+        });
+      }
+      matches.sort((a, b) => b.state - a.state || Number(b.certifiable) - Number(a.certifiable) || b.structural - a.structural || a.id - b.id);
+      return { matches, checked, nominated: list.length, unscreened, identity: this.identity() };
+    } finally {
+      qs.free();
+      for (const s of sides) s.free();
+    }
+  }
+
+  private ident: Identity | null = null;
+
+  /** The comparator and calibration this engine judges with, read from a report it writes. */
+  identity(): Identity {
+    if (!this.ident) {
+      const data = new Uint8Array(16 * 16 * 4);
+      for (let i = 0; i < 256; i++) data.set((i >> 4) % 2 === (i & 15) % 2 ? [255, 255, 255, 255] : [20, 40, 160, 255], i * 4);
+      const fp = this.engine.hash({ data, width: 16, height: 16 });
+      const r = this.engine.compare(fp, fp, { lean: true });
+      this.ident = { comparator: r.comparator, calibration: r.calibration, calibrationId: r.calibrationId };
+    }
+    return this.ident;
+  }
+
+  /** The report for two stored works, with the content hashes of the wires it was computed from. */
+  reportStored(a: number, b: number, lean = false): { text: string; hashA: string; hashB: string } | null {
+    const wa = this.wires(a), wb = this.wires(b);
+    if (!wa || !wb) return null;
+    const text = this.engine.compare({ t1: wa.t1, t2: wa.t2 ?? null }, { t1: wb.t1, t2: wb.t2 ?? null }, { json: true, lean });
+    return { text, hashA: wa.contentHash, hashB: wb.contentHash };
+  }
+
+  /** The full comparator-42 report (JSON text, exactly what paph-js returns) for two works or a query and a work. */
+  report(a: WireInput | number, b: WireInput | number, lean = false): string | null {
+    const wa = typeof a === "number" ? this.wires(a) : a;
+    const wb = typeof b === "number" ? this.wires(b) : b;
+    if (!wa || !wb) return null;
+    return this.engine.compare({ t1: wa.t1, t2: wa.t2 ?? null }, { t1: wb.t1, t2: wb.t2 ?? null }, { json: true, lean });
+  }
+
+  stats(): { works: number; keysVersion: number; stale: number; unreadable: number; identity: Identity; keys: Record<string, { distinct: number; postings: number }> } {
+    const w = this.sql
+      .exec("SELECT COUNT(*) AS n, SUM(keys_version <> ?1 AND keys_version >= 0) AS stale, SUM(keys_version < 0) AS bad FROM paph_works", KEYS_VERSION)
+      .toArray()[0];
+    const keys: Record<string, { distinct: number; postings: number }> = {};
+    for (const r of this.sql.exec("SELECT kind, COUNT(*) AS d, SUM(n) AS p FROM paph_df GROUP BY kind").toArray()) {
+      keys[Number(r.kind) === KIND_CODE ? "codes" : "bands"] = { distinct: Number(r.d), postings: Number(r.p ?? 0) };
+    }
+    return { works: Number(w?.n ?? 0), keysVersion: KEYS_VERSION, stale: Number(w?.stale ?? 0), unreadable: Number(w?.bad ?? 0), identity: this.identity(), keys };
+  }
+}
+
+const round = (x: number): number => Math.round(x * 1e4) / 1e4;
