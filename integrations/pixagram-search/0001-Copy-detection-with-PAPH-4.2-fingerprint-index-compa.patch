index 0000000..904f4ca
--- /dev/null
+++ b/src/paph/copies.ts
@@ -0,0 +1,488 @@
+// Copy detection, Worker side.
+//
+//   enrich: decode ─► PAPH hash (here, ~5–60 ms of WASM) ─► PaphIndex.index()
+//             stores the wires, indexes their keys, compares the work against what the keys,
+//             pHash and embedding neighbours nominate ─► verdicts ─► D1 paph_matches
+//   API:    /copies/:id          stored verdicts (D1 only)
+//           /copies-by-image     an upload, hashed here, checked in the index
+//           /copies/:a/report/:b the comparator's full evidence report, optionally with wires
+//
+// The index lives in a Durable Object (src/paph/index-do.ts) so the comparator runs next to
+// the fingerprints; D1 keeps only verdicts, which list and filter with everything else.
+
+import type { Env } from "../env";
+import { int, now } from "../env";
+import { decodeImage, encodePng, type ContainerInfo, type RgbaImage } from "../enrich/decode";
+import { embedImages, embeddingEnabled } from "../enrich/embed";
+import { hamming, phash as phashOf } from "../enrich/phash";
+import { factorFor, upscale } from "../enrich/upscale";
+import { base64Encode, sha256Hex } from "../lib/bytes";
+import { parseSearchRequest } from "../search/params";
+import { hydrateOrdered, knn, type SearchItem } from "../search/service";
+import { findOptions, paphStub } from "./client";
+import { DEFAULT_MAX_PIXELS, KEYS_VERSION, STATE, STATES, fingerprint, stateOf } from "./engine";
+import type { FindOptions, FindResult, Match } from "./store";
+
+export interface CopyInfo {
+  verdict: string;
+  state: number;
+  /** the comparator stands behind the verdict (enough evidence either way) */
+  certifiable: boolean;
+  /** structural agreement and geometric evidence, 0..10000 */
+  structural: number;
+  geometry: number;
+  inliers: number;
+  /** the copy is a reflection */
+  mirrored: boolean;
+  /** when the listed work was published relative to the one asked about (chain time) */
+  relation: "earlier" | "later" | null;
+  same_author: boolean | null;
+  /** the channels that nominated the pair: codes, bands, phash, vector, previous */
+  via: string[];
+  computed?: number;
+}
+
+export type CopyItem = SearchItem & { copy: CopyInfo };
+
+export interface MatchRow {
+  a: number;
+  b: number;
+  verdict: string;
+  state: number;
+  certifiable: number;
+  structural: number;
+  geometry: number;
+  inliers: number;
+  mirrored: number;
+  same_author: number;
+  via: string;
+  comparator: number;
+  calibration: string;
+  computed: number;
+}
+
+interface PostMeta {
+  id: number;
+  created: number;
+  author: string;
+}
+
+/** Hydration filter for copy listings: live posts only, nsfw included (provenance is not a feed). */
+const LIVE = parseSearchRequest(new URLSearchParams("nsfw=include"));
+
+const maxPixels = (env: Env): number => Math.max(1, int(env.PAPH_MAX_PIXELS, DEFAULT_MAX_PIXELS));
+const perChannel = (env: Env): number => Math.min(64, Math.max(1, int(env.PAPH_CANDIDATES, 32)));
+
+/** x was published before y: chain time, then id. */
+export function earlier(x: PostMeta, y: PostMeta): boolean {
+  return x.created < y.created || (x.created === y.created && x.id < y.id);
+}
+
+// ---- candidate channels outside the index ---------------------------------------------------
+
+/** Works whose 64-bit pHash is within `maxDistance` (via the 8-bit chunk index; exact for ≤ 7). */
+export async function phashNeighbours(db: D1Database, hash: string, maxDistance: number, limit: number, excludeId?: number): Promise<number[]> {
+  if (!/^[0-9a-f]{16}$/.test(hash)) return [];
+  const chunks: number[] = [];
+  for (let i = 0; i < 16; i += 2) chunks.push(parseInt(hash.slice(i, i + 2), 16));
+  const where = chunks.map((_, i) => `(c.idx = ${i} AND c.val = ?)`).join(" OR ");
+  const rows = await db
+    .prepare(`SELECT DISTINCT c.post_id AS id, a.phash FROM phash_chunks c JOIN artworks a ON a.post_id = c.post_id JOIN posts p ON p.id = c.post_id WHERE p.deleted = 0 AND (${where}) LIMIT 2000`)
+    .bind(...chunks)
+    .all<{ id: number; phash: string | null }>();
+  return (rows.results ?? [])
+    .filter((x) => x.id !== excludeId && x.phash)
+    .map((x) => ({ id: x.id, d: hamming(hash, x.phash!) }))
+    .filter((x) => x.d <= maxDistance)
+    .sort((x, y) => x.d - y.d || x.id - y.id)
+    .slice(0, limit)
+    .map((x) => x.id);
+}
+
+/** Nearest neighbours of an image embedding (Vectorize). A fresh vector can be queried at once. */
+export async function vectorNeighboursOf(env: Env, values: number[], k: number, excludeId?: number): Promise<number[]> {
+  try {
+    const res = await env.VEC.query(values, { topK: Math.min(100, k + 1), returnValues: false, returnMetadata: "none" });
+    return res.matches.map((m) => Number(m.id)).filter((id) => Number.isSafeInteger(id) && id !== excludeId).slice(0, k);
+  } catch (e) {
+    console.warn("paph: vector neighbours unavailable", e instanceof Error ? e.message : e);
+    return [];
+  }
+}
+
+/** Nearest neighbours of a stored work's embedding, when it has one. */
+export async function vectorNeighbours(env: Env, postId: number, k: number): Promise<number[]> {
+  if (!embeddingEnabled(env)) return [];
+  try {
+    const v = await env.VEC.getByIds([String(postId)]);
+    return v[0]?.values ? vectorNeighboursOf(env, v[0].values as number[], k, postId) : [];
+  } catch (e) {
+    console.warn("paph: stored vector unavailable", postId, e instanceof Error ? e.message : e);
+    return [];
+  }
+}
+
+/**
+ * Partners a work already has verdicts with, strongest first — re-checked when the work is
+ * re-indexed for the same image (a new key version, a forced run), so their verdicts are
+ * refreshed. A few hundred at most: verdicts beyond that are not re-checked, and so not
+ * replaced, which leaves them as they were — still about the same two images.
+ */
+export async function partnersOf(db: D1Database, postId: number, limit = 256): Promise<number[]> {
+  const r = await db
+    .prepare(
+      `SELECT CASE WHEN a = ?1 THEN b ELSE a END AS id FROM paph_matches WHERE a = ?1 OR b = ?1
+       ORDER BY state DESC, structural DESC LIMIT ?2`,
+    )
+    .bind(postId, limit)
+    .all<{ id: number }>();
+  return (r.results ?? []).map((x) => x.id);
+}
+
+const tag = (ids: number[], via: string): Array<{ id: number; via: string }> => ids.map((id) => ({ id, via }));
+
+// ---- verdicts in D1 -------------------------------------------------------------------------
+
+async function postMeta(db: D1Database, ids: number[]): Promise<Map<number, PostMeta>> {
+  if (!ids.length) return new Map();
+  const r = await db.prepare("SELECT id, created, author FROM posts WHERE id IN (SELECT value FROM json_each(?))").bind(JSON.stringify(ids)).all<PostMeta>();
+  return new Map((r.results ?? []).map((x) => [x.id, x]));
+}
+
+/**
+ * Write what one check concluded, atomically: the verdicts of every pair it examined are
+ * replaced (a pair that no longer holds disappears), pairs it did not examine are left alone
+ * (another work's check established them), and — when `complete` — artworks.paph_hash marks the
+ * stage done for this image. A verdict is only written while both images are still the ones
+ * it was reached on and both posts are live: a check that raced a partner's image change or
+ * deletion cannot resurrect a verdict about an image that is gone. Three statements whatever
+ * the number of verdicts.
+ */
+export async function replaceMatches(
+  db: D1Database,
+  postId: number,
+  contentHash: string,
+  res: Pick<FindResult, "matches" | "checked" | "identity">,
+  complete: boolean,
+): Promise<number> {
+  const meta = await postMeta(db, [postId, ...res.matches.map((m) => m.id)]);
+  const me = meta.get(postId);
+  const rows: Array<Record<string, unknown>> = [];
+  for (const m of res.matches) {
+    const other = meta.get(m.id);
+    if (!me || !other) continue;
+    const [a, b] = earlier(me, other) ? [me.id, other.id] : [other.id, me.id];
+    rows.push({
+      a, b, other: other.id, other_hash: m.contentHash, verdict: m.verdict, state: m.state, certifiable: m.certifiable ? 1 : 0,
+      structural: m.structural, geometry: m.geometryEvidence, inliers: m.totalInliers, mirrored: m.mirrored ? 1 : 0,
+      same_author: me.author === other.author ? 1 : 0, via: m.via.join(","),
+    });
+  }
+  const stmts: D1PreparedStatement[] = [
+    db
+      .prepare(
+        `DELETE FROM paph_matches
+         WHERE (a = ?1 AND b IN (SELECT value FROM json_each(?2))) OR (b = ?1 AND a IN (SELECT value FROM json_each(?2)))`,
+      )
+      .bind(postId, JSON.stringify(res.checked)),
+  ];
+  if (rows.length) {
+    stmts.push(
+      db
+        .prepare(
+          `INSERT INTO paph_matches (a, b, verdict, state, certifiable, structural, geometry, inliers, mirrored, same_author, via, comparator, calibration, computed)
+           SELECT json_extract(j.value, '$.a'), json_extract(j.value, '$.b'), json_extract(j.value, '$.verdict'),
+                  json_extract(j.value, '$.state'), json_extract(j.value, '$.certifiable'), json_extract(j.value, '$.structural'),
+                  json_extract(j.value, '$.geometry'), json_extract(j.value, '$.inliers'), json_extract(j.value, '$.mirrored'),
+                  json_extract(j.value, '$.same_author'), json_extract(j.value, '$.via'), ?2, ?3, ?4
+           FROM json_each(?1) AS j
+           WHERE EXISTS (SELECT 1 FROM artworks w JOIN posts p ON p.id = w.post_id
+                         WHERE w.post_id = json_extract(j.value, '$.other') AND w.content_hash = json_extract(j.value, '$.other_hash') AND p.deleted = 0)
+             AND EXISTS (SELECT 1 FROM artworks w JOIN posts p ON p.id = w.post_id
+                         WHERE w.post_id = ?5 AND w.content_hash = ?6 AND p.deleted = 0)
+           ON CONFLICT(a, b) DO UPDATE SET verdict = excluded.verdict, state = excluded.state, certifiable = excluded.certifiable,
+             structural = excluded.structural, geometry = excluded.geometry, inliers = excluded.inliers, mirrored = excluded.mirrored,
+             same_author = excluded.same_author, via = excluded.via, comparator = excluded.comparator, calibration = excluded.calibration,
+             computed = excluded.computed`,
+        )
+        .bind(JSON.stringify(rows), res.identity.comparator, res.identity.calibrationId, now(), postId, contentHash),
+    );
+  }
+  if (complete) stmts.push(db.prepare("UPDATE artworks SET paph_hash = ?1 WHERE post_id = ?2 AND content_hash = ?1").bind(contentHash, postId));
+  await db.batch(stmts);
+  return rows.length;
+}
+
+/** Take a work out of copy detection: its fingerprint, its keys, its verdicts. Best effort on the index. */
+export async function removePaph(env: Env, postId: number): Promise<void> {
+  await env.DB.batch([
+    env.DB.prepare("DELETE FROM paph_matches WHERE a = ?1 OR b = ?1").bind(postId),
+    env.DB.prepare("UPDATE artworks SET paph_hash = NULL WHERE post_id = ?").bind(postId),
+  ]);
+  if (env.PAPH) {
+    try {
+      await paphStub(env).remove(postId);
+    } catch (e) {
+      console.warn("paph index delete failed", postId, e instanceof Error ? e.message : e);
+    }
+  }
+}
+
+export async function storedMatches(db: D1Database, postId: number, minState: number, limit: number): Promise<MatchRow[]> {
+  const r = await db
+    .prepare(
+      `SELECT * FROM paph_matches WHERE (a = ?1 OR b = ?1) AND state >= ?2
+       ORDER BY state DESC, certifiable DESC, structural DESC, a, b LIMIT ?3`,
+    )
+    .bind(postId, minState, limit)
+    .all<MatchRow>();
+  return r.results ?? [];
+}
+
+function copyFromRow(r: MatchRow, about: number): CopyInfo {
+  return {
+    verdict: r.verdict,
+    state: r.state,
+    certifiable: r.certifiable === 1,
+    structural: r.structural,
+    geometry: r.geometry,
+    inliers: r.inliers,
+    mirrored: r.mirrored === 1,
+    relation: r.a === about ? "later" : "earlier",
+    same_author: r.same_author === 1,
+    via: r.via ? r.via.split(",") : [],
+    computed: r.computed,
+  };
+}
+
+function copyFromMatch(m: Match, about: PostMeta | null, item: SearchItem): CopyInfo {
+  return {
+    verdict: m.verdict,
+    state: m.state,
+    certifiable: m.certifiable,
+    structural: m.structural,
+    geometry: m.geometryEvidence,
+    inliers: m.totalInliers,
+    mirrored: m.mirrored,
+    relation: about ? (earlier({ id: item.id, created: item.created, author: item.author }, about) ? "earlier" : "later") : null,
+    same_author: about ? about.author === item.author : null,
+    via: m.via,
+  };
+}
+
+async function hydrateMatches(env: Env, matches: Match[], about: PostMeta | null, limit: number): Promise<CopyItem[]> {
+  const top = matches.slice(0, limit);
+  const items = await hydrateOrdered(env.DB, top.map((m) => m.id), LIVE);
+  const byId = new Map(top.map((m) => [m.id, m]));
+  return items.map((it) => ({ ...it, copy: copyFromMatch(byId.get(it.id)!, about, it) }));
+}
+
+// ---- the enrichment stage ---------------------------------------------------------------------
+
+export interface StageInput {
+  postId: number;
+  /** sha256 of the image bytes */
+  hash: string;
+  /** the work's pHash, when the stats stage has computed it */
+  phash: string | null;
+  /** artworks.paph_hash: the image the stage last completed for */
+  paphHash: string | null;
+  force: boolean;
+}
+
+export type StageOutcome =
+  | { status: "unchanged" }
+  | { status: "superseded" }
+  | { status: "done"; result: FindResult; stored: number; keys: { codes: number; bands: number }; fit: { divided: number; boxed: number } };
+
+/**
+ * Hash the work, index it, check it against the corpus, store the verdicts. A no-op for an
+ * image the stage already completed under the current key version, unless forced. When the
+ * image changed, its old verdicts go first — they were about another image — and if the run
+ * then fails, the old fingerprint goes too; for the same image, previous partners are re-checked
+ * so their verdicts are refreshed. Runs before the AI stages, on the pixels stats decoded; the
+ * work's own embedding nominates later, in `paphVectorPass`, once this run has one.
+ */
+export async function paphStage(env: Env, s: StageInput, image: () => Promise<RgbaImage>): Promise<StageOutcome> {
+  const stub = paphStub(env);
+  const info = await stub.info(s.postId);
+  if (!s.force && s.paphHash === s.hash && info && info.contentHash === s.hash && info.keysVersion === KEYS_VERSION) return { status: "unchanged" };
+  const changed = !!info && info.contentHash !== s.hash;
+  try {
+    // incomplete until replaceMatches says otherwise; a changed image's verdicts were about the old one
+    await env.DB.batch([
+      env.DB.prepare("UPDATE artworks SET paph_hash = NULL WHERE post_id = ?").bind(s.postId),
+      ...(changed ? [env.DB.prepare("DELETE FROM paph_matches WHERE a = ?1 OR b = ?1").bind(s.postId)] : []),
+    ]);
+    const fp = await fingerprint(await image(), maxPixels(env));
+    // a newer image of this post may have overtaken this run (two messages in flight): the
+    // stats stage has written its hash, and indexing this one would put an older image back
+    const current = await env.DB.prepare("SELECT content_hash FROM artworks WHERE post_id = ?").bind(s.postId).first<{ content_hash: string }>();
+    if (current && current.content_hash !== s.hash) return { status: "superseded" };
+    const k = perChannel(env);
+    const [previous, near, similar] = await Promise.all([
+      changed ? Promise.resolve([]) : partnersOf(env.DB, s.postId),
+      s.phash ? phashNeighbours(env.DB, s.phash, int(env.PAPH_PHASH_DISTANCE, 10), k, s.postId) : Promise.resolve([]),
+      vectorNeighbours(env, s.postId, Math.min(32, k)),
+    ]);
+    const extra = [...tag(previous, "previous"), ...tag(near, "phash"), ...tag(similar, "vector")];
+    const res = await stub.index({ postId: s.postId, contentHash: s.hash, t1: fp.t1, t2: fp.t2 }, findOptions(env, extra));
+    const stored = await replaceMatches(env.DB, s.postId, s.hash, res, true);
+    return { status: "done", result: res, stored, keys: res.keys, fit: fp.fit };
+  } catch (e) {
+    if (changed) await removePaph(env, s.postId).catch(() => {});
+    throw e;
+  }
+}
+
+/**
+ * Check a work against the neighbours of the image embedding this run just computed — Vectorize
+ * does not show a vector it was just given, so the stage could not use it. Only the new
+ * candidates are compared (no key nomination); their verdicts are replaced, nothing else.
+ */
+export async function paphVectorPass(env: Env, postId: number, contentHash: string, vector: number[]): Promise<number> {
+  const ids = await vectorNeighboursOf(env, vector, Math.min(32, perChannel(env)), postId);
+  if (!ids.length) return 0;
+  const res = await paphStub(env).find(postId, { ...findOptions(env, tag(ids, "vector")), keys: false });
+  return replaceMatches(env.DB, postId, contentHash, res, false);
+}
+
+/** Errors the paph stage should not retry: the image or its wire is refused by the engine. */
+export function paphPermanent(e: unknown): boolean {
+  return /^limit:|refused|unsupported|Tier 1/i.test(e instanceof Error ? e.message : String(e));
+}
+
+// ---- API helpers ------------------------------------------------------------------------------
+
+export interface CopiesResponse {
+  id: number;
+  min: string;
+  method: "stored" | "live";
+  /** the stage has completed for the work's current image */
+  indexed: boolean;
+  items: CopyItem[];
+  stats?: { nominated: number; checked: number; unscreened: number };
+}
+
+export async function copiesOf(env: Env, id: number, o: { min?: string; limit?: number; live?: boolean }): Promise<CopiesResponse> {
+  const minState = stateOf(o.min, STATE.Copy);
+  const limit = Math.min(100, Math.max(1, o.limit ?? 24));
+  const min = STATES[minState];
+  const art = await env.DB.prepare("SELECT content_hash, paph_hash, phash FROM artworks WHERE post_id = ?").bind(id).first<{ content_hash: string; paph_hash: string | null; phash: string | null }>();
+  const indexed = !!art?.paph_hash && art.paph_hash === art.content_hash;
+  if (!o.live) {
+    const rows = await storedMatches(env.DB, id, minState, limit);
+    const ids = rows.map((r) => (r.a === id ? r.b : r.a));
+    const items = await hydrateOrdered(env.DB, ids, LIVE);
+    const byOther = new Map(rows.map((r) => [r.a === id ? r.b : r.a, r]));
+    return { id, min, method: "stored", indexed, items: items.map((it) => ({ ...it, copy: copyFromRow(byOther.get(it.id)!, id) })) };
+  }
+  const about = (await postMeta(env.DB, [id])).get(id) ?? null;
+  const k = perChannel(env);
+  const [previous, near, similar] = await Promise.all([
+    partnersOf(env.DB, id),
+    art?.phash ? phashNeighbours(env.DB, art.phash, int(env.PAPH_PHASH_DISTANCE, 10), k, id) : Promise.resolve([]),
+    vectorNeighbours(env, id, Math.min(32, k)),
+  ]);
+  const res = await paphStub(env).find(id, findOptions(env, [...tag(previous, "previous"), ...tag(near, "phash"), ...tag(similar, "vector")], minState));
+  return {
+    id, min, method: "live", indexed,
+    items: await hydrateMatches(env, res.matches, about, limit),
+    stats: { nominated: res.nominated, checked: res.checked.length, unscreened: res.unscreened },
+  };
+}
+
+export interface ImageCopiesResponse {
+  min: string;
+  width: number;
+  height: number;
+  kp: number;
+  /** how the upload was reduced before hashing, when it was over the pixel budget */
+  fit: { divided: number; boxed: number };
+  phash: string;
+  items: CopyItem[];
+  stats: { nominated: number; checked: number; unscreened: number };
+}
+
+/**
+ * Copies of an uploaded image (not stored): hash it here, nominate with its keys and its pHash
+ * (and, with `semantic`, its SigLIP neighbours), compare in the index. The answer for the same
+ * bytes and parameters is cached for ten minutes and looked up before any work is done:
+ * comparisons run in one Durable Object, and a re-submitted image should not queue behind itself.
+ */
+export async function copiesOfImage(
+  env: Env,
+  bytes: Uint8Array,
+  info: ContainerInfo,
+  o: { min?: string; limit?: number; semantic?: boolean },
+): Promise<ImageCopiesResponse & { note?: string }> {
+  const minState = stateOf(o.min, STATE.Suspected);
+  const limit = Math.min(100, Math.max(1, o.limit ?? 24));
+  const semantic = !!o.semantic && embeddingEnabled(env);
+  const cacheKey = `copies-by-image:${KEYS_VERSION}:${await sha256Hex(bytes)}:${minState}:${limit}:${semantic ? 1 : 0}`;
+  const cached = (await env.CACHE.get(cacheKey, "json").catch(() => null)) as ImageCopiesResponse | null;
+  if (cached) return cached;
+
+  const img = await decodeImage(bytes, info);
+  let vectorIds: number[] = [];
+  let note: string | undefined;
+  if (semantic) {
+    try {
+      const scaled = upscale(img, factorFor(img.width, img.height, int(env.UPSCALE_TARGET, 800)), (env.SCALER ?? "xbrz") === "nearest" ? "nearest" : "xbrz");
+      const emb = await embedImages(env, [base64Encode(await encodePng(scaled))]);
+      vectorIds = (await knn(env, emb.embeddings[0], null, 16)).map((h) => h.id);
+    } catch (e) {
+      note = `semantic candidates unavailable: ${e instanceof Error ? e.message : String(e)}`;
+    }
+  } else if (o.semantic) note = "semantic candidates disabled (HF_EMBED_URL not set)";
+
+  const fp = await fingerprint(img, maxPixels(env));
+  const ph = phashOf(img);
+  const near = await phashNeighbours(env.DB, ph, int(env.PAPH_PHASH_DISTANCE, 10), perChannel(env));
+  const extra: FindOptions["extra"] = [...tag(near, "phash"), ...tag(vectorIds, "vector")];
+  const res = await paphStub(env).find({ t1: fp.t1, t2: fp.t2 }, findOptions(env, extra, minState));
+  const out: ImageCopiesResponse = {
+    min: STATES[minState],
+    width: fp.width,
+    height: fp.height,
+    kp: fp.kp,
+    fit: fp.fit,
+    phash: ph,
+    items: await hydrateMatches(env, res.matches, null, limit),
+    stats: { nominated: res.nominated, checked: res.checked.length, unscreened: res.unscreened },
+  };
+  if (!note) await env.CACHE.put(cacheKey, JSON.stringify(out), { expirationTtl: 600 }).catch(() => {});
+  return note ? { ...out, note } : out;
+}
+
+/**
+ * The comparator-42 report for two stored works, and optionally their wires for re-verification.
+ * Cached by both content hashes (an image change is a new key, never a stale answer).
+ */
+export async function pairReport(env: Env, a: number, b: number, withWires: boolean): Promise<Record<string, unknown> | null> {
+  const stub = paphStub(env);
+  const hashes = await env.DB
+    .prepare("SELECT post_id, content_hash FROM artworks WHERE post_id IN (?, ?)")
+    .bind(a, b)
+    .all<{ post_id: number; content_hash: string }>();
+  const h = new Map((hashes.results ?? []).map((r) => [r.post_id, r.content_hash]));
+  const cacheKey = h.has(a) && h.has(b) ? `paph-report:${a}:${h.get(a)}:${b}:${h.get(b)}:${withWires ? 1 : 0}` : null;
+  if (cacheKey) {
+    const cached = (await env.CACHE.get(cacheKey, "json").catch(() => null)) as Record<string, unknown> | null;
+    if (cached) return cached;
+  }
+  const rep = await stub.reportStored(a, b);
+  if (rep === null) return null;
+  const out: Record<string, unknown> = { a, b, report: JSON.parse(rep.text) };
+  if (withWires) {
+    const [wa, wb] = await Promise.all([stub.wires(a), stub.wires(b)]);
+    const enc = (w: { t1: Uint8Array; t2?: Uint8Array | null; contentHash: string } | null) =>
+      w ? { content_hash: w.contentHash, t1: base64Encode(w.t1), t2: w.t2 ? base64Encode(w.t2) : null } : null;
+    out.wires = { a: enc(wa), b: enc(wb) };
+  }
+  // cache only a report computed from the images D1 knows: a stage may be re-indexing one of them
+  if (cacheKey && rep.hashA === h.get(a) && rep.hashB === h.get(b)) {
+    await env.CACHE.put(cacheKey, JSON.stringify(out), { expirationTtl: 3600 }).catch(() => {});
+  }
+  return out;
+}
diff --git a/src/paph/engine.ts b/src/paph/engine.ts
new file mode 100644
index 0000000..dd57d23
--- /dev/null
+++ b/src/paph/engine.ts
@@ -0,0 +1,144 @@
+// PAPH 4.2 — the perceptual-hash engine behind copy detection, as WebAssembly.
+//
+// One instance per isolate. The module is registered by the entry point (Wrangler turns
+// `import x from "*.wasm"` into a compiled WebAssembly.Module; Workers cannot compile wasm
+// from bytes at run time), tests register one compiled from disk.
+
+import { init, KEYS_VERSION, STATES, WIRE_VERSION, type Engine, type HashResult } from "../../vendor/paph/paph.js";
+import type { RgbaImage } from "../enrich/decode";
+
+export type { Engine, HashResult, IndexKeys, RankRecord, Side, Verdict } from "../../vendor/paph/paph.js";
+export { KEYS_VERSION, STATES, WIRE_VERSION };
+
+let mod: WebAssembly.Module | null = null;
+let ready: Promise<Engine> | null = null;
+
+/** Register the compiled module. Safe to call repeatedly; the first call wins. */
+export function setPaphModule(m: WebAssembly.Module): void {
+  if (!mod) mod = m;
+}
+
+export function paphEngine(): Promise<Engine> {
+  if (!ready) {
+    if (!mod) return Promise.reject(new Error("paph: wasm module not registered (setPaphModule)"));
+    ready = init(mod);
+  }
+  return ready;
+}
+
+/** Verdict states in comparator order: Unrelated 0 … Identical 4, Indeterminate 5. */
+export const STATE = { Unrelated: 0, Related: 1, Suspected: 2, Copy: 3, Identical: 4, Indeterminate: 5 } as const;
+
+/** "copy" | "Copy" | "3" → 3; anything else → the fallback. Indeterminate is never a threshold. */
+export function stateOf(v: string | undefined | null, fallback: number): number {
+  if (!v) return fallback;
+  const n = Number(v);
+  if (Number.isInteger(n) && n >= 0 && n <= 4) return n;
+  const i = STATES.findIndex((s) => s.toLowerCase() === v.trim().toLowerCase());
+  return i >= 0 && i <= 4 ? i : fallback;
+}
+
+export interface Fingerprint {
+  t1: Uint8Array;
+  t2: Uint8Array;
+  width: number;
+  height: number;
+  kp: number;
+  /** how the image was reduced before hashing (1, 1 = it was not: the wire is the image's own) */
+  fit: { divided: number; boxed: number };
+}
+
+/**
+ * Pixel budget for hashing in a Worker. The hasher's working memory is ~60 bytes per pixel and
+ * WebAssembly memory never shrinks, while an isolate has 128 MB for everything: 768² (~37 MB
+ * peak) leaves room for the codecs and the JavaScript heap. Pixagram artworks are typically
+ * under 430 px on the long side, far inside it.
+ */
+export const DEFAULT_MAX_PIXELS = 768 * 768;
+
+/** k such that the image is an exact k-fold nearest blow-up: gcd(w, h, every colour-change position). */
+export function upscaleFactor(img: RgbaImage): number {
+  const { width: w, height: h } = img;
+  const d = img.data.byteOffset % 4 === 0 ? img.data : img.data.slice();
+  const px = new Uint32Array(d.buffer, d.byteOffset, w * h);
+  const gcd = (a: number, b: number): number => {
+    while (b) [a, b] = [b, a % b];
+    return a;
+  };
+  let g = gcd(w, h);
+  for (let y = 0; y < h && g > 1; y++) {
+    const row = y * w;
+    for (let x = 1; x < w && g > 1; x++) if (px[row + x] !== px[row + x - 1]) g = gcd(g, x);
+    if (y > 0 && g > 1) {
+      for (let x = 0; x < w; x++) if (px[row + x] !== px[row - w + x]) {
+        g = gcd(g, y);
+        break;
+      }
+    }
+  }
+  return g;
+}
+
+/** Every k-th pixel of every k-th row: the exact inverse of a k-fold blow-up. */
+function nearestDivide(img: RgbaImage, k: number): RgbaImage {
+  const w = img.width / k, h = img.height / k;
+  const d = img.data.byteOffset % 4 === 0 ? img.data : img.data.slice();
+  const src = new Uint32Array(d.buffer, d.byteOffset, img.width * img.height);
+  const out = new Uint32Array(w * h);
+  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) out[y * w + x] = src[y * k * img.width + x * k];
+  return { width: w, height: h, data: new Uint8Array(out.buffer) };
+}
+
+/** Integer box filter: each output pixel is the rounded mean of an f×f block (clipped at the edges). */
+function boxDown(img: RgbaImage, f: number): RgbaImage {
+  const w = Math.ceil(img.width / f), h = Math.ceil(img.height / f);
+  const out = new Uint8Array(w * h * 4);
+  for (let y = 0; y < h; y++) {
+    const y1 = Math.min(img.height, (y + 1) * f);
+    for (let x = 0; x < w; x++) {
+      const x1 = Math.min(img.width, (x + 1) * f);
+      let r = 0, g = 0, b = 0, a = 0, n = 0;
+      for (let yy = y * f; yy < y1; yy++) {
+        for (let xx = x * f; xx < x1; xx++) {
+          const i = (yy * img.width + xx) * 4;
+          r += img.data[i]; g += img.data[i + 1]; b += img.data[i + 2]; a += img.data[i + 3]; n++;
+        }
+      }
+      const o = (y * w + x) * 4, half = n >> 1;
+      out[o] = ((r + half) / n) | 0; out[o + 1] = ((g + half) / n) | 0; out[o + 2] = ((b + half) / n) | 0; out[o + 3] = ((a + half) / n) | 0;
+    }
+  }
+  return { width: w, height: h, data: out };
+}
+
+/**
+ * Bring an image inside the budget. Within it — after dividing out an exact blow-up, which the
+ * hasher does itself — the image is hashed as it is, so its wire is the one anyone computes from
+ * the same pixels. Beyond it, the blow-up is divided here, and what is still too large is box-
+ * filtered by the smallest integer factor that fits (deterministic, so a re-upload of the same
+ * large image still hashes to the same wire).
+ */
+export function fitForHash(img: RgbaImage, maxPixels: number): { img: RgbaImage; divided: number; boxed: number } {
+  const k = upscaleFactor(img);
+  const effective = (img.width / k) * (img.height / k);
+  if (effective <= maxPixels && img.width * img.height <= 4 * maxPixels) return { img, divided: 1, boxed: 1 };
+  let out = k > 1 ? nearestDivide(img, k) : img;
+  let boxed = 1;
+  if (out.width * out.height > maxPixels) {
+    boxed = Math.max(2, Math.ceil(Math.sqrt((out.width * out.height) / maxPixels)));
+    while (Math.ceil(out.width / boxed) * Math.ceil(out.height / boxed) > maxPixels) boxed++;
+    out = boxDown(out, boxed);
+  }
+  return { img: out, divided: k, boxed };
+}
+
+/**
+ * Hash decoded RGBA pixels: Tier 1 (3952 B) and Tier 2 (32 + 40·kp B), byte-identical to paph-js
+ * for any image within the budget (see fitForHash for the rest).
+ */
+export async function fingerprint(img: RgbaImage, maxPixels = DEFAULT_MAX_PIXELS): Promise<Fingerprint> {
+  const fit = fitForHash(img, Math.max(1, maxPixels));
+  const paph = await paphEngine();
+  const r: HashResult = paph.hash({ data: fit.img.data, width: fit.img.width, height: fit.img.height });
+  return { t1: r.t1, t2: r.t2, width: r.width, height: r.height, kp: r.kpCount, fit: { divided: fit.divided, boxed: fit.boxed } };
+}
diff --git a/src/paph/index-do.ts b/src/paph/index-do.ts
