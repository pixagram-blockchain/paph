+#!/usr/bin/env node
+/**
+ * Copy detection, end to end, in the real runtime.
+ *
+ * Starts the Worker in workerd (`wrangler dev --local`, local D1/R2/KV/Queues/Durable Objects)
+ * against a mock chain RPC that serves six artworks — two real Pixagram fixtures, three copies
+ * of one of them made by other "authors" (mirrored, pasted into the other artwork, recoloured)
+ * and an unrelated piece — then drives the public and admin API:
+ *
+ *   ingest all six ─► queue consumer: stats + paph stages ─► PaphIndex DO + D1 paph_matches
+ *   GET  /copies/:id               the stored verdicts, earlier/later by chain time
+ *   GET  /copies/:id?live=1        the same, recomputed now (admin token)
+ *   POST /copies-by-image          an upload (a crop) finds its original
+ *   GET  /copies/:a/report/:b?wires=1   the evidence report, re-verified here from the wires
+ *   delete a copy on chain ─► re-ingest ─► it leaves the index and the verdicts
+ *
+ *     npm run e2e:paph        (no network, no Cloudflare account)
+ */
+import { spawn, execFileSync } from "node:child_process";
+import { createServer } from "node:http";
+import { existsSync, mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { createRequire } from "node:module";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const root = join(here, "..", "..");
+const require = createRequire(join(root, "package.json"));
+const CONFIG = join(here, "wrangler.e2e.jsonc");
+const PORT = 8799, RPC_PORT = 8788, TOKEN = "e2e-admin";
+const BASE = `http://127.0.0.1:${PORT}`;
+
+let failures = 0;
+const ok = (cond, label, detail = "") => {
+  console.log(`  ${cond ? "PASS" : "FAIL"} ${label}${detail ? `  — ${detail}` : ""}`);
+  if (!cond) failures++;
+};
+
+// ---- images ---------------------------------------------------------------------------------
+
+const webp = await import(require.resolve("@jsquash/webp/decode"));
+await webp.init(await WebAssembly.compile(readFileSync(require.resolve("@jsquash/webp/codec/dec/webp_dec.wasm"))));
+const png = await import(require.resolve("@jsquash/png/encode"));
+await png.init(await WebAssembly.compile(readFileSync(require.resolve("@jsquash/png/codec/pkg/squoosh_png_bg.wasm"))));
+
+const fixture = (f) => readFileSync(join(root, "test", "fixtures", f));
+async function decode(buf) {
+  const r = await webp.default(buf.buffer.slice(buf.byteOffset, buf.byteOffset + buf.byteLength));
+  return { width: r.width, height: r.height, data: new Uint8Array(r.data.buffer) };
+}
+const encode = async (im) => Buffer.from(await png.default({ width: im.width, height: im.height, data: new Uint8ClampedArray(im.data.buffer) }));
+const px = (im, x, y) => im.data.subarray((y * im.width + x) * 4, (y * im.width + x) * 4 + 4);
+function mirror(im) {
+  const out = new Uint8Array(im.data.length);
+  for (let y = 0; y < im.height; y++) for (let x = 0; x < im.width; x++) out.set(px(im, x, y), (y * im.width + im.width - 1 - x) * 4);
+  return { ...im, data: out };
+}
+function paste(g, host, ox, oy) {
+  const out = host.data.slice();
+  for (let y = 0; y < g.height; y++) for (let x = 0; x < g.width; x++) if (px(g, x, y)[3] >= 128) out.set(px(g, x, y), ((oy + y) * host.width + ox + x) * 4);
+  return { ...host, data: out };
+}
+function swapRB(im) {
+  const out = im.data.slice();
+  for (let i = 0; i < out.length; i += 4) [out[i], out[i + 2]] = [out[i + 2], out[i]];
+  return { ...im, data: out };
+}
+function crop(im, x0, y0, w, h) {
+  const out = new Uint8Array(w * h * 4);
+  for (let y = 0; y < h; y++) out.set(im.data.subarray(((y0 + y) * im.width + x0) * 4, ((y0 + y) * im.width + x0 + w) * 4), y * w * 4);
+  return { width: w, height: h, data: out };
+}
+function abstract(w, h, seed) {
+  let s = seed;
+  const r = () => ((s = (s * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
+  const data = new Uint8Array(w * h * 4);
+  for (let i = 0; i < data.length; i += 4) data.set([40, 44, 60, 255], i);
+  for (let k = 0; k < 30; k++) {
+    const bw = 6 + ((r() * 30) | 0), bh = 6 + ((r() * 30) | 0), bx = (r() * (w - bw)) | 0, by = (r() * (h - bh)) | 0;
+    const c = [(r() * 256) | 0, (r() * 256) | 0, (r() * 256) | 0, 255];
+    for (let y = by; y < by + bh; y++) for (let x = bx; x < bx + bw; x++) if ((x ^ y) & 1 || k % 3) data.set(c, (y * w + x) * 4);
+  }
+  return { width: w, height: h, data };
+}
+
+const small = await decode(fixture("small.webp")); // "Anonymous", 108×134
+const second = await decode(fixture("second.webp")); // "Space Invader", 224×224
+const uri = (mime, bytes) => `data:${mime};base64,${Buffer.from(bytes).toString("base64")}`;
+
+// ---- the mock chain ----------------------------------------------------------------------------
+
+const template = JSON.parse(readFileSync(join(root, "test", "fixtures", "posts.json"), "utf8")).artwork_small;
+function post(author, permlink, day, title, body, tags) {
+  const created = `2026-09-0${day}T12:00:00`;
+  return {
+    ...template, author, permlink, title, root_title: title, body, body_length: body.length, created, last_update: created,
+    url: `/${tags[0]}/@${author}/${permlink}`, category: tags[0], parent_author: "", active_votes: [], net_rshares: 0,
+    json_metadata: JSON.stringify({ app: "pixagram/3.0.2", format: "image", tags, description: title, nsfw: false }),
+  };
+}
+const chain = new Map();
+const add = (p) => chain.set(`${p.author}/${p.permlink}`, p);
+add(post("matias", "anonymous", 1, "Anonymous", uri("image/webp", fixture("small.webp")), ["anonymous", "mask"]));
+add(post("matus", "space-invader", 2, "Space Invader", uri("image/webp", fixture("second.webp")), ["spaceinvader"]));
+add(post("copycat", "mask-mirrored", 3, "My mask", uri("image/png", await encode(mirror(small))), ["mask"]));
+add(post("collager", "invader-and-mask", 4, "Invasion", uri("image/png", await encode(paste(small, second, 60, 45))), ["collage"]));
+add(post("recolorist", "blue-mask", 5, "Blue mask", uri("image/png", await encode(swapRB(small))), ["mask"]));
+add(post("other", "abstract", 6, "Abstract", uri("image/png", await encode(abstract(160, 120, 7))), ["abstract"]));
+
+const rpc = createServer((req, res) => {
+  let body = "";
+  req.on("data", (c) => (body += c));
+  req.on("end", () => {
+    const { id, method, params } = JSON.parse(body || "{}");
+    const reply = (result) => res.end(JSON.stringify({ jsonrpc: "2.0", id, result }));
+    res.setHeader("content-type", "application/json");
+    if (method === "condenser_api.get_content") return reply(chain.get(`${params[0]}/${params[1]}`) ?? {});
+    res.end(JSON.stringify({ jsonrpc: "2.0", id, error: { code: -32601, message: `mock chain: ${method} not served` } }));
+  });
+});
+await new Promise((r) => rpc.listen(RPC_PORT, "127.0.0.1", r));
+
+// ---- the Worker ---------------------------------------------------------------------------------
+
+const state = mkdtempSync(join(tmpdir(), "paph-e2e-"));
+const env = { ...process.env, CI: "1", NO_PROXY: "127.0.0.1,localhost", no_proxy: "127.0.0.1,localhost", WRANGLER_SEND_METRICS: "false" };
+const wrangler = join(root, "node_modules", ".bin", "wrangler");
+execFileSync(wrangler, ["d1", "migrations", "apply", "pixagram-search-e2e", "--local", "--config", CONFIG, "--persist-to", state], { env, stdio: "pipe" });
+const dev = spawn(wrangler, ["dev", "--config", CONFIG, "--local", "--ip", "127.0.0.1", "--port", String(PORT), "--persist-to", state, "--show-interactive-dev-session=false"], { env, stdio: ["ignore", "pipe", "pipe"], detached: true });
+let log = "";
+dev.stdout.on("data", (d) => (log += d));
+dev.stderr.on("data", (d) => (log += d));
+
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+async function api(path, init = {}) {
+  const r = await fetch(BASE + path, { ...init, headers: { authorization: `Bearer ${TOKEN}`, "content-type": "application/json", ...(init.headers ?? {}) } });
+  const text = await r.text();
+  try {
+    return { status: r.status, body: JSON.parse(text) };
+  } catch {
+    return { status: r.status, body: text };
+  }
+}
+async function until(fn, ms, label) {
+  const t0 = Date.now();
+  for (;;) {
+    try {
+      const v = await fn();
+      if (v) return v;
+    } catch { /* not up yet */ }
+    if (Date.now() - t0 > ms) throw new Error(`timed out waiting for ${label}\n${log.slice(-4000)}`);
+    await sleep(250);
+  }
+}
+
+function shutdown() {
+  try { process.kill(-dev.pid, "SIGTERM"); } catch { /* gone */ }
+  rpc.close();
+  rmSync(state, { recursive: true, force: true });
+}
+
+try {
+  await until(async () => (await api("/healthz")).status === 200, 90_000, "wrangler dev");
+  console.log(`\nworkerd up (${BASE}); mock chain on :${RPC_PORT}; state in ${state}\n`);
+
+  // ---- ingest: the enrichment queue does the rest
+  const ids = {};
+  for (const p of chain.values()) {
+    const r = await api(`/admin/ingest/${p.author}/${p.permlink}`, { method: "POST" });
+    ids[p.author] = r.body.postId;
+  }
+  ok(Object.values(ids).every((x) => Number.isInteger(x)), "six artworks ingested", JSON.stringify(ids));
+  const t0 = Date.now();
+  const paph = await until(async () => {
+    const r = await api("/admin/paph");
+    const done = (r.body.jobs ?? []).find((j) => j.status === "done")?.n ?? 0;
+    return done >= 6 ? r.body : null;
+  }, 120_000, "the paph stage on all six");
+  console.log(`  queue drained in ${((Date.now() - t0) / 1000).toFixed(1)} s — index: ${JSON.stringify(paph.index)}`);
+  ok(paph.index.works === 6, "the PaphIndex Durable Object holds six works");
+  ok(paph.index.keys.codes.postings > 0 && paph.index.keys.bands.postings > 0, "both key families are indexed");
+
+  // ---- stored verdicts
+  const orig = await api(`/copies/${ids.matias}`);
+  const byAuthor = Object.fromEntries((orig.body.items ?? []).map((it) => [it.author, it.copy]));
+  console.log("\n  /copies of the original:");
+  for (const it of orig.body.items ?? []) console.log(`    @${it.author.padEnd(10)} ${it.copy.verdict.padEnd(10)} ${it.copy.relation.padEnd(7)} structural ${it.copy.structural}  via ${it.copy.via.join("+")}${it.copy.mirrored ? "  (mirrored)" : ""}`);
+  ok(byAuthor.copycat?.verdict === "Copy" && byAuthor.copycat.relation === "later" && byAuthor.copycat.mirrored, "the mirrored copy: Copy, published later, reflection");
+  ok(byAuthor.collager?.verdict === "Copy", "the collage containing it: Copy");
+  ok(byAuthor.recolorist?.verdict === "Copy", "the recoloured copy: Copy");
+  ok(!byAuthor.matus && !byAuthor.other, "the unrelated artworks are not listed");
+  const back = await api(`/copies/${ids.copycat}`);
+  const theOriginal = (back.body.items ?? []).find((it) => it.author === "matias");
+  ok(theOriginal?.copy.relation === "earlier" && theOriginal.copy.same_author === false, "seen from the copy, the original is earlier and by someone else");
+  const host = await api(`/copies/${ids.matus}`);
+  ok((host.body.items ?? []).map((it) => it.author).join() === "collager", "the pasted-into artwork lists only the collage", (host.body.items ?? []).map((it) => `${it.author}:${it.copy.verdict}`).join(" "));
+
+  // ---- every artwork reports the stage complete for its current image
+  const items = await Promise.all(Object.values(ids).map((id) => api(`/posts/${id}`)));
+  ok(items.every((r) => r.body.artwork?.stages?.paph === true), "every artwork's stages.paph is true");
+
+  // ---- live recomputation agrees with the stored verdicts, and is not public
+  const live = await api(`/copies/${ids.matias}?live=1`);
+  const liveSet = (live.body.items ?? []).map((it) => `${it.id}:${it.copy.verdict}`).sort().join();
+  const storedSet = (orig.body.items ?? []).map((it) => `${it.id}:${it.copy.verdict}`).sort().join();
+  ok(live.body.method === "live" && liveSet === storedSet, "live=1 recomputes the same verdicts", `${live.body.stats?.checked} checked`);
+  const anon = await fetch(`${BASE}/copies/${ids.matias}?live=1`);
+  ok(anon.status === 403, "live=1 without the admin token is refused");
+
+  // ---- an upload
+  const cropped = await encode(crop(small, 10, 13, 86, 107));
+  const up = await api("/copies-by-image", { method: "POST", body: JSON.stringify({ image: uri("image/png", cropped) }) });
+  const found = (up.body.items ?? []).find((it) => it.author === "matias");
+  ok(up.status === 200 && found && found.copy.state >= 3, "an uploaded crop finds the original", `${up.body.items?.map((it) => `${it.author}:${it.copy.verdict}`).join(" ")}; ${up.body.stats?.checked} checked`);
+  const again = await api("/copies-by-image", { method: "POST", body: JSON.stringify({ image: uri("image/png", cropped) }) });
+  ok(JSON.stringify(again.body) === JSON.stringify(up.body), "the same upload again is answered from the cache, identically");
+
+  // ---- the evidence report, re-verified from the published wires
+  const rep = await api(`/copies/${ids.matias}/report/${ids.copycat}?wires=1`);
+  ok(rep.status === 200 && rep.body.report?.comparator === 42 && rep.body.report.verdict === "Copy", "the report endpoint returns comparator 42's report", rep.body.report?.class);
+  const w = rep.body.wires;
+  const bytes = (s) => (s ? new Uint8Array(Buffer.from(s, "base64")) : null);
+  const { init } = await import(join(root, "vendor", "paph", "paph.js"));
+  const local = await init(await WebAssembly.compile(readFileSync(join(root, "vendor", "paph", "paph.wasm"))));
+  const rerun = local.compare({ t1: bytes(w.a.t1), t2: bytes(w.a.t2) }, { t1: bytes(w.b.t1), t2: bytes(w.b.t2) }, { json: true });
+  ok(rerun === JSON.stringify(rep.body.report), "re-running the engine on the published wires gives the same report, byte for byte");
+  const jsEngine = join(root, "..", "paph", "src", "paph-js.cjs");
+  if (existsSync(jsEngine)) {
+    const V = require(jsEngine);
+    const js = JSON.stringify(V.compare(bytes(w.a.t1), bytes(w.a.t2), bytes(w.b.t1), bytes(w.b.t2), {}, V.cal()));
+    ok(js === JSON.stringify(rep.body.report), "and so does the JavaScript engine (paph-js), independently written");
+  }
+
+  // the on-demand routes share a per-client budget (4 a minute in this configuration)
+  const burst = [];
+  for (let i = 0; i < 4; i++) burst.push((await fetch(`${BASE}/copies/${ids.matias}/report/${ids.copycat}`)).status);
+  ok(burst.includes(429) && burst[0] === 200, "the on-demand routes are rate-limited per client", burst.join(" "));
+
+  // ---- deletion on chain
+  const copycat = chain.get("copycat/mask-mirrored");
+  chain.set("copycat/mask-mirrored", { ...copycat, body: "deleted", last_update: "2026-09-07T12:00:00" });
+  await api(`/admin/ingest/copycat/mask-mirrored`, { method: "POST" });
+  const after = await api(`/copies/${ids.matias}`);
+  ok(!(after.body.items ?? []).some((it) => it.author === "copycat"), "a copy deleted on chain leaves the verdicts");
+  const stats = await api("/admin/paph");
+  ok(stats.body.index.works === 5, "and the index", JSON.stringify(stats.body.verdicts));
+  ok(stats.body.index.identity?.comparator === 42 && /^[0-9a-f]+$/.test(stats.body.index.identity?.calibrationId ?? ""), "the index names its comparator and calibration", JSON.stringify(stats.body.index.identity));
+  const alerts = await api("/admin/paph/alerts?days=30");
+  ok((alerts.body.alerts ?? []).every((a) => a.earlier.author !== a.later.author) && alerts.body.alerts.length >= 2, "the alerts feed lists cross-author copies", (alerts.body.alerts ?? []).map((a) => `${a.earlier.author}→${a.later.author}:${a.verdict}`).join(" "));
+} catch (e) {
+  failures++;
+  console.error(e);
+} finally {
+  shutdown();
+}
+console.log(`\n${failures ? `${failures} FAILED` : "all passed"}`);
+process.exit(failures ? 1 : 0);
