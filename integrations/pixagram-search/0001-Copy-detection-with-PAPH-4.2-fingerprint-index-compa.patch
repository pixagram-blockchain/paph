+    w.post(4, "recolorist", 300, "h4");
+    await w.run(1, "h1", small);
+    await w.run(3, "h3", second);
+    await w.run(4, "h4", swapRedBlue(small));
+    w.db.prepare("DELETE FROM paph_matches").run(); // as if the keys had not nominated 1
+    w.queried.push([3, 1]);
+    expect(await paphVectorPass(w.env, 4, "h4", [0.1, 0.2])).toBe(1);
+    expect(w.pairs()).toEqual(["1-4:Copy"]);
+    const via = w.db.prepare("SELECT via FROM paph_matches").get().via;
+    expect(via).toBe("vector");
+    expect(w.db.prepare("SELECT paph_hash FROM artworks WHERE post_id = 4").get().paph_hash).toBe("h4");
+  });
+});
+
+describe("copy relations", () => {
+  it("orders a pair by chain time, then id", () => {
+    expect(earlier({ id: 5, created: 100, author: "a" }, { id: 2, created: 200, author: "b" })).toBe(true);
+    expect(earlier({ id: 5, created: 200, author: "a" }, { id: 2, created: 100, author: "b" })).toBe(false);
+    expect(earlier({ id: 2, created: 100, author: "a" }, { id: 5, created: 100, author: "b" })).toBe(true);
+  });
+});
