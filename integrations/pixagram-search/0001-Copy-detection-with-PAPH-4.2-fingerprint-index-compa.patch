+// The Worker's handle on the PaphIndex Durable Object. Kept apart from index-do.ts so modules
+// that only call the index never import `cloudflare:workers` (and stay testable in Node).
+
+import type { Env } from "../env";
+import { bool, int } from "../env";
+import type { PaphIndex } from "./index-do";
+import { STATE, stateOf } from "./engine";
+import type { FindOptions } from "./store";
+
+export function paphStub(env: Env): DurableObjectStub<PaphIndex> {
+  return env.PAPH.get(env.PAPH.idFromName("main")) as unknown as DurableObjectStub<PaphIndex>;
+}
+
+export function paphEnabled(env: Env): boolean {
+  return bool(env.PAPH_ENABLED, true) && !!env.PAPH;
+}
+
+/** Find options from the environment, plus extra candidates nominated by other channels. */
+export function findOptions(env: Env, extra: FindOptions["extra"] = [], minState?: number): FindOptions {
+  return {
+    perFamily: Math.min(128, Math.max(1, int(env.PAPH_CANDIDATES, 32))),
+    dfCap: Math.max(2, int(env.PAPH_DF_CAP, 256)),
+    minState: minState ?? stateOf(env.PAPH_MIN_VERDICT, STATE.Suspected),
+    extra,
+  };
+}
