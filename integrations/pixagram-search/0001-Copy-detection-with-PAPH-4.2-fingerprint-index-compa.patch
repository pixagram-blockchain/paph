+    expect(await replaceMatches(DB, 2, "h2", { matches: [copy(1, { mirrored: true })], checked: [1, 3], identity }, true)).toBe(1);
+    expect(pairs(db)).toEqual(["1-2:Copy"]);
+    expect(db.prepare("SELECT comparator, calibration, same_author, mirrored, via FROM paph_matches").get()).toMatchObject({
+      comparator: 42, calibration: identity.calibrationId, same_author: 0, mirrored: 1, via: "codes",
+    });
+    expect(db.prepare("SELECT paph_hash FROM artworks WHERE post_id = 2").get().paph_hash).toBe("h2");
+  });
