@@ -1,6 +1,8 @@
 import { readFileSync } from "node:fs";
 import { createRequire } from "node:module";
 import { initCodecs } from "../src/enrich/decode";
+import { paphEngine, setPaphModule, type Engine } from "../src/paph/engine";
+import type { Sql, Transact } from "../src/paph/store";
 
 const require = createRequire(import.meta.url);
 
@@ -25,3 +27,80 @@ export function fixture(name: string): Uint8Array {
 export function fixtureJson<T = any>(name: string): T {
   return JSON.parse(readFileSync(new URL(`./fixtures/${name}`, import.meta.url), "utf8")) as T;
 }
+
+let paph: Promise<Engine> | null = null;
+
+/** Compile the vendored PAPH module from disk (what Wrangler does at build time). */
+export function paphReady(): Promise<Engine> {
+  if (!paph) {
+    paph = (async () => {
+      setPaphModule(await WebAssembly.compile(readFileSync(new URL("../vendor/paph/paph.wasm", import.meta.url))));
+      return paphEngine();
+    })();
+  }
+  return paph;
+}
+
+/**
+ * Durable Object SqlStorage on node:sqlite: same SQLite, same SQL. BLOBs are bound as
+ * ArrayBuffer by the store (what Durable Objects take) and come back as Uint8Array here
+ * (ArrayBuffer there) — the store accepts both.
+ */
+export function sqliteStorage(): { sql: Sql; transact: Transact; db: any } {
+  const { DatabaseSync } = require("node:sqlite");
+  const db = new DatabaseSync(":memory:");
+  const conv = (v: unknown) => (v instanceof ArrayBuffer ? new Uint8Array(v) : v);
+  const sql: Sql = {
+    exec(query: string, ...bindings: unknown[]) {
+      const rows = db.prepare(query).all(...(bindings.map(conv) as any[])) as Record<string, unknown>[];
+      return { toArray: () => rows };
+    },
+  };
+  const transact: Transact = (fn) => {
+    db.exec("BEGIN");
+    try {
+      const r = fn();
+      db.exec("COMMIT");
+      return r;
+    } catch (e) {
+      db.exec("ROLLBACK");
+      throw e;
+    }
+  };
+  return { sql, transact, db };
+}
+
+/**
+ * A D1Database over node:sqlite with both migrations applied — enough of D1's surface
+ * (prepare/bind/all/first/run, batch as one transaction) for the modules that write verdicts.
+ */
+export function d1Memory(): { DB: D1Database; db: any } {
+  const { DatabaseSync } = require("node:sqlite");
+  const db = new DatabaseSync(":memory:");
+  for (const m of ["0001_init.sql", "0002_paph.sql"]) db.exec(readFileSync(new URL(`../migrations/${m}`, import.meta.url), "utf8"));
+  const stmt = (sql: string, params: unknown[] = []): any => ({
+    bind: (...p: unknown[]) => stmt(sql, p),
+    all: async () => ({ results: db.prepare(sql).all(...params), success: true }),
+    first: async (col?: string) => {
+      const r = db.prepare(sql).get(...params);
+      return r === undefined ? null : col ? r[col] : r;
+    },
+    run: async () => (db.prepare(sql).run(...params), { success: true }),
+    _run: () => db.prepare(sql).all(...params),
+  });
+  const DB = {
+    prepare: (sql: string) => stmt(sql),
+    batch: async (stmts: any[]) => {
+      db.exec("BEGIN");
+      try {
+        const out = stmts.map((s) => ({ results: s._run(), success: true }));
+        db.exec("COMMIT");
+        return out;
+      } catch (e) {
+        db.exec("ROLLBACK");
+        throw e;
+      }
+    },
+  } as unknown as D1Database;
+  return { DB, db };
+}
