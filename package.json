{
  "name": "@pixagram/paph-x",
  "version": "1.1.0",
  "description": "PAPH-X — PAPH 4.2's integer-only perceptual hash and calibrated comparator for pixel-art copy detection, with the retrieval-native cascade that reaches the same verdicts through a cheaper path, and PAPH-SI, the screening index that finds the few stored works worth comparing. Optimized Rust reference compiled to WebAssembly (SIMD128), a JavaScript engine that agrees byte for byte, index keys for search engines, and the evidence bench.",
  "license": "MIT",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./wasm": {
      "types": "./wasm/paph.d.ts",
      "import": "./wasm/paph.js"
    },
    "./wasm/paph.wasm": "./wasm/paph.wasm",
    "./wasm/paph-baseline.wasm": "./wasm/paph-baseline.wasm",
    "./wire": {
      "types": "./src/wire.d.ts",
      "import": "./src/wire.js",
      "require": "./src/wire.cjs"
    },
    "./comparator": {
      "types": "./src/paph-js.d.ts",
      "import": "./src/paph-js.js",
      "require": "./src/paph-js.cjs"
    },
    "./calibration": "./demo/cal-core.cjs",
    "./demo/bench": "./demo/paph4x.html"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "src/",
    "wasm/",
    "rust/src/",
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/.cargo/",
    "rust/check.sh",
    "rust/bench.sh",
    "rust/sibench.sh",
    "demo/",
    "docs/",
    "tools/",
    "test/*.mjs",
    "test/*.cjs",
    "test/equiv-digest.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/wire.cjs && node test/comparator.cjs",
    "test:wasm": "node test/wasm-parity.mjs",
    "test:wasm:quick": "node test/wasm-parity.mjs --quick",
    "test:equiv": "node test/wasm-equiv.mjs",
    "test:x": "node test/x-wasm.mjs",
    "test:x:quick": "node test/x-wasm.mjs --quick",
    "bench:x": "node test/x-bench.mjs",
    "test:si": "node --no-warnings test/si-wasm.mjs",
    "test:si:quick": "node --no-warnings test/si-wasm.mjs --quick",
    "bench:si": "bash rust/sibench.sh",
    "test:bench": "node test/bench.mjs",
    "test:native": "cargo build --release --manifest-path rust/Cargo.toml && node test/parity-native.mjs",
    "test:rust": "bash rust/check.sh",
    "verify": "npm test && npm run test:wasm && npm run test:bench",
    "bench": "node test/bench-engines.mjs",
    "recall": "node test/index-recall.mjs",
    "build:wasm": "bash tools/build-wasm.sh",
    "build:bench": "node tools/build-paph4x.mjs"
  },
  "devDependencies": {
    "binaryen": "^132.0.0",
    "jsdom": "^26.1.0"
  },
  "keywords": [
    "perceptual-hash",
    "pixel-art",
    "plagiarism",
    "copy-detection",
    "image-search",
    "screening-index",
    "wasm",
    "simd",
    "deterministic",
    "nft",
    "paph"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "author": "Pixagram SA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixagram-blockchain/paph.git"
  }
}
